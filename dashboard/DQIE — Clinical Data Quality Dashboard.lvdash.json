{
  "datasets": [
    {
      "name": "severity_distribution",
      "displayName": "Severity Distribution",
      "queryLines": [
        "SELECT\n",
        "  severity_level,\n",
        "  count\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.severity_distribution\n",
        "ORDER BY\n",
        "  CASE severity_level\n",
        "    WHEN 'low-risk' THEN 1\n",
        "    WHEN 'medium-risk' THEN 2\n",
        "    WHEN 'high-risk' THEN 3\n",
        "  END"
      ]
    },
    {
      "name": "source_type_comparison",
      "displayName": "Source Type Comparison",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN sources_involved LIKE '%,%' THEN 'Multi-source'\n",
        "    WHEN\n",
        "      sources_involved IS NOT NULL\n",
        "      AND sources_involved != ''\n",
        "    THEN\n",
        "      'Single-source'\n",
        "    ELSE 'Unknown'\n",
        "  END as source_type,\n",
        "  COUNT(*) as count\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.entity_scores\n",
        "WHERE\n",
        "  sources_involved IS NOT NULL\n",
        "GROUP BY\n",
        "  source_type"
      ]
    },
    {
      "name": "severity_level_count",
      "displayName": "Severity Level Count",
      "queryLines": [
        "SELECT\n",
        "  severity_level,\n",
        "  COUNT(*) as count\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.entity_scores\n",
        "GROUP BY\n",
        "  severity_level\n",
        "ORDER BY\n",
        "  CASE severity_level\n",
        "    WHEN 'low-risk' THEN 1\n",
        "    WHEN 'medium-risk' THEN 2\n",
        "    WHEN 'high-risk' THEN 3\n",
        "  END"
      ]
    },
    {
      "name": "entities_multi_source",
      "displayName": "Entities with Multiple Sources",
      "queryLines": [
        "SELECT\n",
        "  entity_type,\n",
        "  entity_id,\n",
        "  dqi_score,\n",
        "  severity_level,\n",
        "  sources_involved\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.entity_scores\n",
        "WHERE\n",
        "  sources_involved LIKE '%,%'\n",
        "ORDER BY\n",
        "  dqi_score DESC"
      ]
    },
    {
      "name": "score_by_entity_type",
      "displayName": "Score by Entity Type",
      "queryLines": [
        "SELECT\n",
        "  entity_type,\n",
        "  avg_score\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.score_by_entity_type\n",
        "ORDER BY\n",
        "  avg_score DESC"
      ]
    },
    {
      "name": "entity_type_contribution",
      "displayName": "Entity Type Contribution",
      "queryLines": [
        "SELECT\n",
        "  entity_type,\n",
        "  weighted_score\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.entity_type_contribution\n",
        "ORDER BY\n",
        "  weighted_score DESC"
      ]
    },
    {
      "name": "entity_scores_full",
      "displayName": "Entity Scores Full",
      "queryLines": [
        "SELECT\n",
        "  entity_type,\n",
        "  entity_id,\n",
        "  dqi_score,\n",
        "  dqi_label,\n",
        "  severity_level,\n",
        "  anomalies_count,\n",
        "  sources_involved\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.entity_scores\n",
        "ORDER BY\n",
        "  dqi_score DESC"
      ]
    },
    {
      "name": "dataset_score_full",
      "displayName": "Dataset Score Full",
      "queryLines": [
        "SELECT\n",
        "  global_score,\n",
        "  global_label,\n",
        "  weighted_global_score,\n",
        "  weighted_global_label,\n",
        "  anomaly_density,\n",
        "  percentage_multi_source,\n",
        "  multi_source_entities\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.dataset_score"
      ]
    },
    {
      "name": "severity_low_risk",
      "displayName": "Low Risk Count",
      "queryLines": [
        "SELECT\n",
        "  count\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.severity_distribution\n",
        "WHERE\n",
        "  severity_level = 'low-risk'"
      ]
    },
    {
      "name": "severity_high_risk",
      "displayName": "High Risk Count",
      "queryLines": [
        "SELECT\n",
        "  count\n",
        "FROM\n",
        "  `projecto-clinical-data-quality-engine`.gold.severity_distribution\n",
